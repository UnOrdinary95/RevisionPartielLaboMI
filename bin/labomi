#!/usr/bin/env bash
# Lance la plateforme de révision Labo MI et l'ouvre dans le navigateur.
#
#   labomi              met à jour (si possible) puis lance le site
#   labomi update       met à jour sans lancer
#   labomi --no-update  lance sans chercher de mise à jour (ou LABOMI_NO_UPDATE=1)
#   labomi help         affiche cette aide
set -e
UPDATED=

# Dossier du projet = parent de ce script, en suivant les liens symboliques.
# (pas de « readlink -f » : absent sur les anciens macOS)
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
PORT="${LABOMI_PORT:-5173}"
URL="http://localhost:$PORT"

open_url() {
  if command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1 &
  elif command -v open >/dev/null; then open "$1"
  else echo "Ouvre $1 dans ton navigateur"; fi
}

need_pnpm() {
  if ! command -v pnpm >/dev/null; then
    echo "pnpm est introuvable. Installe-le : npm install -g pnpm" >&2
    exit 1
  fi
}

# Met à jour depuis GitHub (avance rapide uniquement). Ne bloque jamais le lancement.
update() {
  cd "$DIR"
  command -v git >/dev/null || { echo "git introuvable : pas de mise à jour."; return 0; }
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 || { echo "Pas de branche distante suivie : pas de mise à jour."; return 0; }

  echo "Recherche de mises à jour…"
  if ! git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=5 fetch --quiet 2>/dev/null; then
    echo "Hors ligne ou GitHub injoignable : on garde la version actuelle."
    return 0
  fi

  BEHIND="$(git rev-list --count 'HEAD..@{u}')"
  AHEAD="$(git rev-list --count '@{u}..HEAD')"
  if [ "$BEHIND" = "0" ]; then
    echo "✓ Déjà à jour."
    return 0
  fi
  if [ "$AHEAD" != "0" ] || ! git diff --quiet || ! git diff --cached --quiet; then
    echo "⚠ $BEHIND mise(s) à jour disponible(s), mais tu as des modifications locales : mise à jour ignorée."
    echo "  (git stash puis labomi update pour la récupérer)"
    return 0
  fi

  OLD="$(git rev-parse HEAD)"
  git merge --ff-only --quiet '@{u}'
  echo "✓ Mis à jour ($BEHIND commit(s)) :"
  git log --format='  • %s' "$OLD..HEAD"

  if ! git diff --quiet "$OLD" HEAD -- package.json pnpm-lock.yaml; then
    echo "Les dépendances ont changé, installation…"
    need_pnpm
    pnpm install --frozen-lockfile || pnpm install
  fi
  chmod +x "$DIR/bin/labomi" "$DIR/install.sh" "$DIR/uninstall.sh" 2>/dev/null || true
  UPDATED=1
}

case "${1:-}" in
  help|-h|--help)
    sed -n '2,7p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  update)
    update
    exit 0
    ;;
  --no-update)
    LABOMI_NO_UPDATE=1
    ;;
esac

if [ -z "$LABOMI_NO_UPDATE" ]; then
  update
  # Le lanceur lui-même a pu changer : on relance la nouvelle version.
  [ -z "$UPDATED" ] || LABOMI_NO_UPDATE=1 exec "$DIR/bin/labomi"
fi

# Déjà lancé ? On ouvre juste le navigateur (Vite recharge tout seul le code mis à jour).
if curl -s "$URL" 2>/dev/null | grep -q "Labo MI"; then
  echo "Labo MI tourne déjà sur $URL"
  open_url "$URL"
  exit 0
fi

need_pnpm
cd "$DIR"
[ -d node_modules ] || pnpm install --frozen-lockfile || pnpm install
exec pnpm dev --port "$PORT" --strictPort --open
